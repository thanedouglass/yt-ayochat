# =============================================================================
# YT-AYOCHAT ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and populate with your own credentials if needed.
# All fields have safe local mock defaults.

# Google Cloud Platform & Vertex AI
GOOGLE_CLOUD_PROJECT=yt-ayochat-prod
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL_NAME=gemini-1.5-pro

# YouTube Data API v3 (Optional for live production polling)
YOUTUBE_API_KEY=
YOUTUBE_TARGET_VIDEO_IDS=

# Karpathy LLM Council / OpenRouter (Optional for live multi-model queries)
OPENROUTER_API_KEY=

# ChromaDB Persistence
CHROMA_PERSIST_DIR=chroma_db

# Telegram Bot & Mobile Human-in-the-Loop (HITL) Pipeline
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-100123456789
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
HITL_DB_PATH=hitl_state.db

# Mobile PWA Companion API
PWA_API_KEY=your_shared_pwa_api_key_here
# Set to true only for local development without a PWA_API_KEY
PWA_ALLOW_UNAUTHENTICATED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to false to post approved replies to YouTube instead of simulating dispatch
DISPATCH_DRY_RUN=true

